generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  agents          Agent[]
  executions      Execution[]
  budget          UserBudget?
  approvals       Approval[]
  connections     Connection[]
  secrets         Secret[]
  memories        MemoryItem[]
  datasets        EvaluationDataset[]
  evaluationRuns  EvaluationRun[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Agent {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String
  name             String
  description      String         @default("")
  archivedAt       DateTime?
  currentVersionId String?        @unique @db.Uuid
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions         AgentVersion[]
  executions       Execution[]
  memories         MemoryItem[]
  evaluationRuns   EvaluationRun[]
  currentVersion   AgentVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  @@index([userId, archivedAt])
  @@map("agent")
}

model AgentVersion {
  id              String   @id @default(uuid()) @db.Uuid
  agentId         String   @db.Uuid
  versionNumber   Int
  name            String
  description     String   @default("")
  instructions    String
  model           String
  temperature     Float
  maxOutputTokens Int
  toolConfig      Json
  memoryConfig    Json
  limits          Json
  approvalPolicy  Json
  createdAt       DateTime @default(now())
  agent           Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  executions      Execution[]
  evaluationRuns  EvaluationRun[]
  currentFor      Agent?      @relation("CurrentVersion")

  @@unique([agentId, versionNumber])
  @@index([agentId, createdAt])
  @@map("agent_version")
}

enum ExecutionStatus {
  queued
  running
  waitingApproval
  succeeded
  failed
  cancelled
  budgetExceeded
}

enum BudgetHoldStatus {
  none
  open
  unresolved
}

enum ExternalEffectStatus {
  reserved
  succeeded
  failed
  uncertain
}

enum ApprovalStatus {
  pending
  approved
  rejected
  expired
}

model UserBudget {
  userId            String   @id
  monthlyTokenCap   Int
  concurrentRunCap  Int
  consumedTokens    Int      @default(0)
  reservedTokens    Int      @default(0)
  periodStart       DateTime
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_budget")
}

model Execution {
  id                     String            @id @default(uuid()) @db.Uuid
  userId                 String
  agentId                String            @db.Uuid
  agentVersionId         String            @db.Uuid
  task                   String
  status                 ExecutionStatus   @default(queued)
  leaseOwner             String?
  leaseExpiresAt         DateTime?
  fencingToken           Int               @default(0)
  heartbeatAt            DateTime?
  cancelRequestedAt      DateTime?
  openHoldTokens         Int               @default(0)
  unresolvedHoldTokens   Int               @default(0)
  budgetReservedTokens   Int               @default(0)
  budgetHoldStatus       BudgetHoldStatus  @default(none)
  finalText              String?
  errorCode              String?
  inputTokens            Int               @default(0)
  outputTokens           Int               @default(0)
  cachedTokens           Int               @default(0)
  reasoningTokens        Int               @default(0)
  embeddingTokens        Int               @default(0)
  webSearchCalls         Int               @default(0)
  estimatedCostUsd       Float?
  langfuseTraceId        String?
  startedAt              DateTime?
  finishedAt             DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  user                   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent                  Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentVersion           AgentVersion      @relation(fields: [agentVersionId], references: [id], onDelete: Restrict)
  checkpoints            ExecutionCheckpoint[]
  steps                  ExecutionStep[]
  effects                ExternalEffect[]
  approvals              Approval[]
  usage                  UsageRecord?
  caseResult             EvaluationCaseResult?

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([status, leaseExpiresAt])
  @@map("execution")
}

model ExecutionCheckpoint {
  id            String   @id @default(uuid()) @db.Uuid
  executionId   String   @db.Uuid
  stepIndex     Int
  messages      Json
  schemaVersion Int
  createdAt     DateTime @default(now())
  execution     Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, stepIndex])
  @@map("execution_checkpoint")
}

model ExecutionStep {
  id              String   @id @default(uuid()) @db.Uuid
  executionId     String   @db.Uuid
  stepIndex       Int
  kind            String
  toolName        String?
  input           Json?
  output          Json?
  inputTokens     Int?
  outputTokens    Int?
  cachedTokens    Int?
  reasoningTokens Int?
  latencyMs       Int?
  createdAt       DateTime @default(now())
  execution       Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, stepIndex])
  @@map("execution_step")
}

model ExternalEffect {
  id             String               @id @default(uuid()) @db.Uuid
  executionId    String               @db.Uuid
  toolCallId     String
  idempotencyKey String?
  status         ExternalEffectStatus
  requestHash    String
  result         Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  execution      Execution            @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([toolCallId])
  @@index([executionId, status])
  @@map("external_effect")
}

model Approval {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String
  executionId     String         @db.Uuid
  toolCallId      String
  approvalId      String
  toolName        String
  proposedInput   Json
  status          ApprovalStatus @default(pending)
  comment         String?
  decidedByUserId String?
  decidedAt       DateTime?
  expiresAt       DateTime
  createdAt       DateTime       @default(now())
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  execution       Execution      @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, approvalId])
  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("approval")
}

model UsageRecord {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String
  executionId      String    @unique @db.Uuid
  inputTokens      Int
  outputTokens     Int
  cachedTokens     Int
  reasoningTokens  Int
  toolCallCount    Int
  embeddingTokens  Int       @default(0)
  webSearchCalls   Int       @default(0)
  estimatedCostUsd Float?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  execution        Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("usage_record")
}

enum ConnectionProvider {
  http
  github
  gmail
  slack
}

enum ConnectionStatus {
  active
  revoked
  error
}

model Connection {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String
  provider          ConnectionProvider
  label             String
  status            ConnectionStatus   @default(active)
  scopes            String[]
  externalAccountId String?
  tokenExpiresAt    DateTime?
  config            Json
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret            Secret?

  @@index([userId, provider])
  @@map("connection")
}

model Secret {
  id           String     @id @default(uuid()) @db.Uuid
  connectionId String     @unique @db.Uuid
  userId       String
  ciphertext   String
  iv           String
  authTag      String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("secret")
}

model OauthState {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String
  provider     ConnectionProvider
  state        String             @unique
  codeVerifier String?
  scopes       String[]
  label        String
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime           @default(now())

  @@index([userId, state])
  @@map("oauth_state")
}

enum MemoryStatus {
  proposed
  accepted
  rejected
}

enum MemoryAuthor {
  agent
  user
}

model MemoryItem {
  id                 String       @id @default(uuid()) @db.Uuid
  userId             String
  agentId            String       @db.Uuid
  content            String
  kind               String       @default("fact")
  embedding          Unsupported("vector(1536)")?
  status             MemoryStatus @default(proposed)
  sourceExecutionId  String?      @db.Uuid
  sourceStepId       String?      @db.Uuid
  toolCallId         String?      @unique
  createdBy          MemoryAuthor
  embeddingHoldTokens Int         @default(0)
  deletedAt          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent              Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([userId, agentId, status])
  @@map("memory_item")
}

enum EvaluationRunStatus {
  running
  completed
  failed
}

model EvaluationDataset {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cases       EvaluationCase[]
  runs        EvaluationRun[]

  @@index([userId, createdAt])
  @@map("evaluation_dataset")
}

model EvaluationCase {
  id         String   @id @default(uuid()) @db.Uuid
  datasetId  String   @db.Uuid
  userId     String
  name       String
  task       String
  assertions Json
  position   Int
  createdAt  DateTime @default(now())
  dataset    EvaluationDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  results    EvaluationCaseResult[]

  @@index([datasetId, position])
  @@map("evaluation_case")
}

model EvaluationRun {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String
  datasetId      String              @db.Uuid
  agentId        String              @db.Uuid
  agentVersionId String              @db.Uuid
  status         EvaluationRunStatus @default(running)
  createdAt      DateTime            @default(now())
  finishedAt     DateTime?
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataset        EvaluationDataset   @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  agent          Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentVersion   AgentVersion        @relation(fields: [agentVersionId], references: [id], onDelete: Restrict)
  results        EvaluationCaseResult[]

  @@index([userId, createdAt])
  @@map("evaluation_run")
}

model EvaluationCaseResult {
  id          String    @id @default(uuid()) @db.Uuid
  runId       String    @db.Uuid
  caseId      String    @db.Uuid
  userId      String
  executionId String?   @unique @db.Uuid
  passed      Boolean?
  score       Float?
  tools       Json?
  costUsd     Float?
  latencyMs   Int?
  details     Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  run         EvaluationRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  case        EvaluationCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  execution   Execution?       @relation(fields: [executionId], references: [id], onDelete: SetNull)

  @@unique([runId, caseId])
  @@map("evaluation_case_result")
}
