# Copy to deploy/langfuse/.env. These secrets stay out of the Orvia app.
# Generate each secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LANGFUSE_DB_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_S3_ACCESS_KEY=
LANGFUSE_S3_SECRET_KEY=
LANGFUSE_NEXTAUTH_URL=http://127.0.0.1:3100
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
# Langfuse expects a 64-character hex encryption key.
LANGFUSE_ENCRYPTION_KEY=
