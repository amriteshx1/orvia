WORKER_CONCURRENCY=2
OPENAI_MODEL=gpt-6-luna
DEFAULT_MAX_STEPS=8
DEFAULT_MAX_WALL_CLOCK_MS=600000
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_FROM=Orvia <noreply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
