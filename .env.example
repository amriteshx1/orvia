NODE_ENV=development
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
DATABASE_URL=postgresql://orvia:orvia@127.0.0.1:5434/orvia
REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=orvia-dev
