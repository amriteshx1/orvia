NODE_ENV=development
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
DATABASE_URL=postgresql://orvia:orvia@127.0.0.1:5434/orvia
REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=orvia-dev
LOG_LEVEL=info
WORKER_CONCURRENCY=2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
DEFAULT_MAX_STEPS=8
DEFAULT_MAX_WALL_CLOCK_MS=600000
DEFAULT_MONTHLY_TOKEN_BUDGET=1000000
DEFAULT_MAX_CONCURRENT_EXECUTIONS=2
APPROVAL_TIMEOUT_HOURS=24
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
DEFAULT_MAX_WEB_SEARCH_CALLS=3
HTTP_TOOL_TIMEOUT_MS=15000
HTTP_TOOL_MAX_RESPONSE_BYTES=1000000
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# 32-byte key as 64 hex characters. Required only when saving or using connection secrets.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=
# GitHub OAuth App. Callback: APP_URL/api/connections/github/callback. Scopes: read:user and repo.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth client. Callback: APP_URL/api/connections/google/callback.
# Read consent: gmail.readonly. Send consent also includes gmail.send and gmail.compose.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_FROM=Orvia <noreply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
